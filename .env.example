# Copier en .env pour activer la synchronisation Supabase.
# Sans ces deux valeurs, l'application fonctionne 100 % en local.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Lecture des reçus par IA (Gemini). Clé obtenue sur https://aistudio.google.com/apikey
# Jamais exposée au navigateur : utilisée par la fonction serveur netlify/functions/ocr.mts
# (et par le serveur de développement). Sur Netlify, la déclarer dans Site settings > Environment variables.
GEMINI_API_KEY=
# Facultatif : modèle préféré (sinon gemini-flash-latest)
# GEMINI_MODEL=gemini-2.5-flash
# Mettre VITE_AI_OCR=off pour désactiver la lecture IA côté application
# VITE_AI_OCR=off
